# Server-only settings. Copy to a private .env for local use; never commit .env.
# Managed hosting: provision these through the platform's secret configuration.
# DATABASE_URL is injected by Manus in the managed environment. Local development
# must use a separate database; this project's managed dev/production DB is shared.
DATABASE_URL=mysql://DB_USER:DB_PASSWORD@DB_HOST:4000/DB_NAME

# Transactional email. Empty by design: no live provider or sender is supplied.
# Provision a real Resend API key and verified sender before registration,
# verification delivery and password-reset delivery can work live.
RESEND_API_KEY=
EMAIL_FROM=

# Set the exact public HTTPS application origin used in verification/reset links.
# Replace the placeholder; do not use a development tunnel in production.
APP_PUBLIC_URL=https://YOUR_APPLICATION_HOST

# Express listen port; managed deployment normally uses 3000.
PORT=3000

# Runtime commands set NODE_ENV (development for dev, production for start).
# No Manus OAuth/JWT app-login settings are needed for the self-managed CRM auth.
# No Google/Alibaba/mailbox-password login or client-exposed secrets in V1.
